# SCOUTASTIC integration — see docs/SCOUTASTIC_SYNC.md
#
# These are read ONLY by scripts/sync-scoutastic.mjs (a standalone Node
# script run locally or by the "Sync SCOUTASTIC" GitHub Actions workflow).
# They are never read by the Next.js frontend and never shipped to the
# browser — the static site only ever reads the already-synced
# data/players.json.
#
# Placeholder names only — never commit a real value. Locally, set these
# as real environment variables in your own shell (never in a file that
# could be committed). In production, set SCOUTASTIC_API_KEY as a GitHub
# Actions repository secret (Settings -> Secrets and variables -> Actions).

# The SCOUTASTIC API key. Sent as the raw `Authorization` header value
# (not "Bearer <key>") — see scripts/lib/scoutasticClient.mjs.
SCOUTASTIC_API_KEY=

# Optional — defaults to https://kvmechelen.scoutastic.com/api/v1
SCOUTASTIC_API_BASE_URL=

# Optional — defaults to "kvmechelen" (used to build the base URL above
# when SCOUTASTIC_API_BASE_URL isn't set)
SCOUTASTIC_CLUB_SUBDOMAIN=

# SofaScore integration — see docs/SOFASCORE_PROVIDER.md
#
# SofaScore has no legitimate public API today (confirmed — see the doc),
# so there is nothing that actually works to configure yet. These exist
# so a real provider can be switched on later with zero code changes
# beyond implementing it. Read ONLY by scripts/sync-sofascore.mjs — never
# by the frontend, never shipped to the browser.
SOFASCORE_PROVIDER=
SOFASCORE_API_KEY=
SOFASCORE_API_BASE_URL=

# Database persistence (Phase 3) — see docs/POSTGRES_PERSISTENCE.md
#
# Supabase's URL and anon key. Unlike every variable above, these ARE
# meant to be public — Next.js inlines NEXT_PUBLIC_* vars into the
# frontend bundle by design, and that's fine here: real access control is
# enforced by the Postgres Row Level Security policies in
# db/rls_policies.sql, not by keeping this key secret. Set these in
# whatever build environment runs `next build` (e.g. a GitHub Actions
# repository variable, since — unlike a secret — it's safe to be visible
# in the built site).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
